{
  "version": "1.0.0",
  "bundleId": "com.agents.dsh.deepseek",
  "productName": "DeepSeek AI",
  "platforms": ["iOS"],
  "deploymentTarget": "16.0",
  "sources": ["."],
  "targets": [
    {
      "name": "DeepSeek",
      "type": "executable",
      "path": ".",
      "sources": [
        "DeepSeekApp.swift",
        "Views/*.swift",
        "Models/*.swift",
        "Services/*.swift",
        "ViewModels/*.swift"
      ],
      "dependencies": [],
      "settings": {
        "defines": [
          {
            "name": "APP_VERSION",
            "value": "1.0.0"
          }
        ]
      }
    },
    {
      "name": "DeepSeekTests",
      "type": "test",
      "path": "Tests",
      "sources": ["*.swift"],
      "dependencies": ["DeepSeek"]
    }
  ]
}
