// iOS 项目配置
// API 配置：使用 Agnes AI (OpenAI 兼容)
// 端点: https://api.agnes-ai.cn/v1

{
  "appName": "DeepSeek AI",
  "bundleId": "com.agents.dsh.deepseek",
  "deploymentTarget": "16.0",
  "swiftVersion": "5.9",
  
  "api": {
    "provider": "agnes-ai",
    "baseUrl": "https://api.agnes-ai.cn/v1",
    "defaultModel": "agnes-2.5-flash",
    "supportedModels": [
      { "id": "agnes-2.5-flash", "name": "Agnes 2.5 Flash", "contextWindow": 128000 },
      { "id": "agnes-2.0-flash", "name": "Agnes 2.0 Flash" }
    ]
  },
  
  "features": {
    "chat": true,
    "codeExecution": true,
    "fileUpload": true,
    "history": true,
    "presets": true,
    "export": true
  }
}
